build
mx.scratch
!.settings

# Local reference material
/references/
/参考资料/
/LVGL综合实验(800x448)/
/docs/
/ml_energy/

# Legacy or example code not linked into the firmware
/device/
/MQTT/sample.c
/MQTT/SDK使用说明.txt
/onenet/inc/onenet.h
/onenet/src/onenet.c

# Local tool-specific settings
/.claude/
/.clangd

# Reference documents are local-only wherever they are stored.
*.pdf
*.doc
*.docx
*.ppt
*.pptx

# Experiment data and archives are local-only wherever they are stored.
*.csv
*.CSV
*.xls
*.xlsx
*.zip

# Local OTA signing material. Never commit a private key.
/tools/config/*.pem

# Device credentials. Commit only the adjacent .example templates.
/Core/Inc/wifi_config.h
/Core/Inc/onenet_config.h

# Python bytecode generated by local tooling/tests
__pycache__/
*.py[cod]
